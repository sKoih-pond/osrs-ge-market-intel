{
  // ge-clock (ADR-0017): cron triggers only. No routes and no workers.dev URL, so the Worker
  // has no HTTP surface; it reads one secret, GITHUB_DISPATCH_TOKEN.
  "$schema": "../site/node_modules/wrangler/config-schema.json",
  "name": "ge-clock",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["6,26 * * * *", "13,43 * * * *"]
  },
  "observability": { "enabled": true }
}
